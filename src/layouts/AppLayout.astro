---
import "@/styles/globals.css";
import ThemeScript from "@/components/ThemeScript.astro";
import AppShell from "@/components/ui/AppShell.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { buildNavigation, buildSecondary, buildWorkspaces } from "@/lib/nav";

interface Props {
  title?: string;
}
const { title = "Controllers · Cerulean Aviation Network" } = Astro.props;

const locale = getLocale(Astro.cookies);
const frameMessages = getMessages(locale, "frame");
const t = useTranslations(locale, "frame");

/**
 * 侧栏对每个登录成员都是同一份，所以这里不给 `buildNavigation()` 传 rating。
 *
 * 以前是传的：教员 / SUP / 管理那几项按 rating 出现或消失。那几项现在不在这个
 * 站上了（`lib/nav.ts` 上写着为什么），于是这个便利也一起没了 —— 而它本来就只
 * 是便利，不是边界：菜单少一项不等于那个页面被保护起来了。真正的判断在 can-api
 * 每条路由自己的守卫上，页面内的门槛（如预约看板的「撤销他人预约」）仍然各自读
 * `Astro.locals.user.rating`。
 */
const user = Astro.locals.user;
const navigation = buildNavigation(t);
const secondary = buildSecondary(t);
const workspaces = buildWorkspaces(t);
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <meta name="theme-color" content="#4c92c1" />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body>
    <AppShell
      navigation={navigation}
      secondary={secondary}
      workspaces={workspaces}
      activeWorkspace="controllers"
      pathname={pathname}
      messages={frameMessages}
      userName={user?.name ?? ""}
      userId={user?.username ?? ""}
      locale={locale}
      client:load
    >
      <slot />
    </AppShell>
  </body>
</html>
