---
import "@/styles/globals.css";
import ThemeScript from "@/components/ThemeScript.astro";
import AppShell from "@/components/ui/AppShell.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { buildNavigation, buildSecondary, buildWorkspaces } from "@/lib/nav";

interface Props {
  title?: string;
}
const { title = "Controllers · Cerulean Aviation Network" } = Astro.props;

const locale = getLocale(Astro.cookies);
const frameMessages = getMessages(locale, "frame");
const t = useTranslations(locale, "frame");

/**
 * 侧栏的门槛读的是会话里的 rating —— can-api 每个请求都解一次，所以一次晋升在
 * 下一次翻页时就生效，而不是等到下次登录。
 *
 * 这是**便利，不是边界**：菜单少一项不等于那个页面被保护起来了，多一项也不等
 * 于放开了什么。真正的判断在 can-api 每条路由自己的守卫上。
 */
const user = Astro.locals.user;
const navigation = buildNavigation(t, user?.rating);
const secondary = buildSecondary(t);
const workspaces = buildWorkspaces(t);
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <meta name="theme-color" content="#4c92c1" />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body>
    <AppShell
      navigation={navigation}
      secondary={secondary}
      workspaces={workspaces}
      activeWorkspace="controllers"
      pathname={pathname}
      messages={frameMessages}
      userName={user?.name ?? ""}
      userId={user?.username ?? ""}
      locale={locale}
      client:load
    >
      <slot />
    </AppShell>
  </body>
</html>
