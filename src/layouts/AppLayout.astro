---
import "@/styles/globals.css";
import ThemeScript from "@jianyuelab-org/can-ui/components/ThemeScript.astro";
import Frame from "@/components/Frame.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { buildNavigation, SITE_ORIGINS } from "@/lib/nav";

interface Props {
  title?: string;
}
const { title = "Controllers · Cerulean Aviation Network" } = Astro.props;

const locale = getLocale(Astro.cookies);
const frameMessages = getMessages(locale, "frame");
const t = useTranslations(locale, "frame");

/**
 * 侧栏是管制员中心的四个页面，每个管制员都一样，没有评级门槛。教员与管理页面是
 * can-portal 的，从外壳的网络切换器进去。分界写在 `lib/nav.ts`。
 *
 * 页面内的门槛（如预约看板的「撤销他人预约」）另有各自的判断，读
 * `Astro.locals.user.rating`。
 */
const user = Astro.locals.user;
const navigation = buildNavigation(t);
/** 账户菜单显示名字和 `#CID`；CID 是会话里的 `username`。 */
const frameUser = user
  ? { name: user.name, id: user.username, rating: user.rating }
  : null;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <meta name="theme-color" content="#4c92c1" />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body>
    <Frame
      locale={locale}
      pathname={pathname}
      nav={navigation}
      user={frameUser}
      messages={frameMessages}
      origins={SITE_ORIGINS}
      client:load
    >
      <slot />
    </Frame>
  </body>
</html>
