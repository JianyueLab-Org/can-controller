---
import "@/styles/globals.css";
import ThemeScript from "@/components/ThemeScript.astro";
import AppShell from "@/components/ui/AppShell.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { buildNavigation, buildSecondary, buildWorkspaces } from "@/lib/nav";

interface Props {
  title?: string;
}
const { title = "Controllers · Cerulean Aviation Network" } = Astro.props;

const locale = getLocale(Astro.cookies);
const frameMessages = getMessages(locale, "frame");
const t = useTranslations(locale, "frame");

/**
 * 侧栏分教员和普通两份，差别只有教员那一组，门槛读的是会话里的 rating ——
 * can-api 每个请求都解一次，所以一次晋升在下一次翻页时就生效，而不是等到下次
 * 登录。
 *
 * **这是便利，不是边界。** 菜单少一项不等于那一页被保护起来了：教员那两条指向
 * 的是主站的页面，拦住普通管制员的是 can-web 的守卫和 can-api 每条路由自己的守
 * 卫。这里的门槛只是为了不给人看一组他点下去必然被拒的链接 —— 把它改小不会放开
 * 任何东西，只会让菜单多出几个 403。
 *
 * 页面内的门槛（如预约看板的「撤销他人预约」）另有各自的判断，同样读
 * `Astro.locals.user.rating`。
 */
const user = Astro.locals.user;
const navigation = buildNavigation(t, user?.rating);
const secondary = buildSecondary(t);
const workspaces = buildWorkspaces(t);
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <meta name="theme-color" content="#4c92c1" />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body>
    <AppShell
      navigation={navigation}
      secondary={secondary}
      workspaces={workspaces}
      activeWorkspace="controllers"
      pathname={pathname}
      messages={frameMessages}
      userName={user?.name ?? ""}
      userId={user?.username ?? ""}
      locale={locale}
      client:load
    >
      <slot />
    </AppShell>
  </body>
</html>
