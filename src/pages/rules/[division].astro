---
import { getCollection, render } from "astro:content";
import AppLayout from "@/layouts/AppLayout.astro";
import { AlertBox, Badge, Icon, PageHeader } from "@jianyuelab-org/can-ui";
import { getLocale, useTranslations } from "@/lib/i18n";
import { findAtcRuleDoc } from "@/lib/atcRules";

const { division } = Astro.params;
const rules = await getCollection("rules");
const doc = findAtcRuleDoc(
  division,
  rules.map((entry) => entry.id),
);

if (!doc) {
  return Astro.redirect("/rules");
}

const entry = rules.find((candidate) => candidate.id === doc.key)!;
const { Content, headings } = await render(entry);
// Chapters and appendices only — the document has 40+ articles, and a list of
// every one of them is a wall, not a table of contents.
const chapters = headings.filter((heading) => heading.depth === 2);

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "controllers.rules");
const tRegion = useTranslations(locale, "divisions.regions");
const tCommon = useTranslations(locale, "common");
const divisionName = tRegion(String(doc.region));
---

<AppLayout title={doc.title}>
  <a
    href="/rules"
    class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-can"
  >
    <Icon name="arrowLeft" class="size-4" />
    {t("back")}
  </a>

  <div class="mb-8">
    <PageHeader
      flush
      title={doc.title}
      eyebrow={`${t("title")} · ${divisionName}`}
      description={t("languageNote", {
        language: tCommon(`languages.${doc.lang}`),
      })}
    >
      <span slot="title" lang={doc.lang}>{doc.title}</span>
      {
        doc.draft && (
          <Badge slot="actions" variant="warning">
            {tCommon("draft")}
          </Badge>
        )
      }
    </PageHeader>
    {
      doc.draft && (
        <AlertBox variant="warning" title={tCommon("draftTitle")} class="mt-4">
          {tCommon("draftNotice")}
        </AlertBox>
      )
    }
  </div>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <article class="card p-6 sm:p-8">
      <!-- Headings clear the sticky bar when the table of contents jumps to
           them. Blockquotes drop the plugin's italics and curly quotes: there
           is no italic CJK face, so the browser slants the glyphs instead. -->
      <div
        lang={doc.lang}
        class="doc-content prose max-w-none dark:prose-invert prose-headings:scroll-mt-[calc(var(--frame-bar-height)+1rem)] prose-headings:tracking-tight prose-a:font-medium prose-blockquote:not-italic prose-blockquote:[quotes:none]"
      >
        <Content />
      </div>
    </article>

    {
      chapters.length > 0 && (
        <aside class="order-first lg:order-none lg:sticky lg:top-24 lg:self-start">
          <nav class="card p-4" aria-label={t("onThisPage")}>
            <h2 class="text-eyebrow mb-3 px-2.5 text-faint">
              {t("onThisPage")}
            </h2>
            <ul class="max-h-[60vh] space-y-0.5 overflow-y-auto">
              {chapters.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    lang={doc.lang}
                    class="block rounded-control px-2.5 py-1.5 text-sm text-muted transition-colors hover:bg-surface-sunken hover:text-ink"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</AppLayout>
